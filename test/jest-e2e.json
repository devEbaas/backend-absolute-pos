{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^\\.\\./\\.\\./\\.\\./package\\.json$": "<rootDir>/../package.json"
  },
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "maxWorkers": 1,
  "testTimeout": 30000
}
